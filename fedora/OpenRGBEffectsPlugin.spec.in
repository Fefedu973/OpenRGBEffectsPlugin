%global _name OpenRGBEffectsPlugin

Name:           openrgb-plugin-effects
Version:        __VERSION__
Release:        0%{?dist}
Summary:        Effects plugin for OpenRGB

License:        GPLv2
URL:            https://gitlab.com/OpenRGBDevelopers/%{_name}

BuildRequires:  gcc-c++ libusbx-devel libstdc++-devel qt6-qtbase-devel qt6-linguist desktop-file-utils systemd-rpm-macros qt6-qt5compat-devel openal-soft-devel pipewire-devel
Requires:       hicolor-icon-theme qt6-qt5compat openal-soft pipewire-libs

%description
Effects plugin for OpenRGB

%prep
cp -r %{_sourcedir}/%{_name}/. %{_builddir}

%build
cd %{_builddir}
export CXXFLAGS=${CXXFLAGS/-pipe}
%qmake_qt6 PREFIX=%{_prefix}
%make_build

%install
%make_install INSTALL_ROOT=%{buildroot}

%files
%{_exec_prefix}/lib/openrgb/plugins/libOpenRGBEffectsPlugin.so
%{_exec_prefix}/share/metainfo/org.openrgb.OpenRGB.Plugin.Effects.metainfo.xml

%changelog
* Fri Aug 21 2026 Adam Honse <calcprogrammer1@gmail.com> - 0.9-0
- Initial package
